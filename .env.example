# Copy to .env (ignored). This example runs locally on HTTP; public production needs HTTPS.
MW_ENV=development
MW_SITE_NAME=Archivo de Juego
MW_SERVER=http://localhost:8080
MW_DB_NAME=archivo
MW_DB_USER=archivo
MW_DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
MARIADB_ROOT_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_PASSWORD
MW_SECRET_KEY=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
MW_UPGRADE_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_HEX_CHARACTERS
MW_ADMIN_USER=Admin
MW_ADMIN_PASSWORD=REPLACE_WITH_LONG_UNIQUE_ADMIN_PASSWORD
# Set a real monitored address before enabling email and publishing legal pages.
MW_CONTACT_EMAIL=
